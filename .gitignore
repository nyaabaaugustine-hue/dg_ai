# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log
chat-test.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated prisma client
/src/generated/prisma
/prisma/src/generated/prisma

# local AI coding assistant skills (third-party tooling)
/.opencode/

# Cloudflare / OpenNext build output and local state
/.open-next/
/.wrangler/
/.mf/
/.cloudflare/
worker-configuration.d.ts

# wrangler local secrets & env
.dev.vars
.dev.vars.*
wrangler.local.toml

# misc tooling caches
/.turbo/
/.eslintcache
/.cache/
*.tsbuildinfo.bak
