# DEGOONY Sales Intelligence — copy to .env and fill in.

# Neon Postgres (use the pooled connection string in serverless environments)
DATABASE_URL="postgresql://user:password@ep-host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Cloudflare Workers AI (https://dash.cloudflare.com -> AI -> Workers AI -> API tokens)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_FAST_MODEL="@cf/meta/llama-4-scout-17b-16e-instruct"
CLOUDFLARE_THINKING_MODEL="@cf/openai/gpt-oss-120b"

# Admin panel (/admin) credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Session signing secret — generate with: openssl rand -hex 32
AUTH_SECRET="generate-a-long-random-string"

APP_NAME="DEGOONY Sales Intelligence"
DEFAULT_CURRENCY="GHS"
