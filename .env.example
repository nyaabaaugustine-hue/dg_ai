# Pragya AI environment template — copy to .env and fill in.

DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Ordered fallback chain of OpenAI-compatible providers (first with a key is primary)
AI_PROVIDERS="groq,kimi,bazaarlink"

GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# Grok (xAI) — enable with an xai-… key from console.x.ai
GROK_API_KEY=""
GROK_BASE_URL="https://api.x.ai/v1"
GROK_MODEL="grok-4.6"

KIMI_API_KEY=""
KIMI_BASE_URL="https://api.moonshot.ai/v1"
KIMI_MODEL="kimi-k2-turbo-preview"

BAZAARLINK_API_KEY=""
BAZAARLINK_BASE_URL="https://api.bazaarlink.ai/v1"
BAZAARLINK_MODEL=""

APIFREELLM_API_KEY=""
APIFREELLM_BASE_URL="https://apifreellm.com/api/v1"
APIFREELLM_MODEL="apifreellm"

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

EMBEDDING_PROVIDER="openai"
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL="https://api.openai.com/v1"
EMBEDDING_MODEL="text-embedding-3-small"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
AUTH_SECRET="generate-a-long-random-string"

APP_NAME="Pragya AI"
DEFAULT_CURRENCY="GHS"
